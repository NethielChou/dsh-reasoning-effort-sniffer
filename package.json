{
  "name": "@nethiel/dsh-reasoning-effort-sniffer",
  "version": "0.6.0",
  "type": "module",
  "description": "Sniffs which thinking levels each third-party pi-ai route actually accepts and declares them, so the composer's model picker offers a strength switch; a sidebar panel switches sniffing and strength per provider.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning-effort",
    "thinking",
    "sniffer",
    "pi-ai",
    "cordis"
  ],
  "author": "NethielChou",
  "license": "MIT",
  "icon": "icon.svg",
  "homepage": "https://github.com/NethielChou/dsh-reasoning-effort-sniffer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NethielChou/dsh-reasoning-effort-sniffer.git"
  },
  "bugs": {
    "url": "https://github.com/NethielChou/dsh-reasoning-effort-sniffer/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-alpha.2": "compatible"
      }
    }
  }
}


